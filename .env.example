# App Store packaging & upload secrets. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real credentials.

# Apple Developer Team ID (10 chars).
TEAM_ID=752556J5V6

# Path to the Mac App Store provisioning profile.
PROFILE=/Users/mgorunuch/Developer/VTT_Mac_App_Store.provisionprofile

# App Store Connect credentials for altool upload.
# AC_USER: the Apple ID email of an account with access to the app.
# AC_PASS: an APP-SPECIFIC password (appleid.apple.com -> Sign-In & Security
#          -> App-Specific Passwords), NOT your normal Apple ID password.
AC_USER=your-apple-id@email.com
AC_PASS=xxxx-xxxx-xxxx-xxxx
